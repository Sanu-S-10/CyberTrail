{
  "name": "cyber-fraud-money-trail-analyzer",
  "private": true,
  "version": "1.0.0",
  "description": "Cyber Fraud Money Trail Analyzer — Investigation Support Tool",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "preview": "npm --prefix frontend run preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
